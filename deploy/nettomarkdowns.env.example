# Copy to ~/apps/nettomarkdowns/nettomarkdowns.env on the server and chmod 600 it.
# Double underscore stands for a config section, so Salling__ApiKey is Salling:ApiKey.

Salling__ApiKey=

# Postcodes to log. Add more lines with __1, __2 and so on.
MarkdownLog__Zips__0=5000

# Time between polls (hh:mm:ss).
MarkdownLog__Interval=00:15:00
