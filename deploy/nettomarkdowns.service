[Unit]
Description=NettoMarkdowns dashboard and markdown logger
Wants=network-online.target
After=network-online.target

[Service]
User=lauge
WorkingDirectory=/home/lauge/apps/nettomarkdowns/app
ExecStart=/home/lauge/apps/nettomarkdowns/app/NettoMarkdowns
EnvironmentFile=/home/lauge/apps/nettomarkdowns/nettomarkdowns.env
# Localhost only. Tailscale Serve is the way in, and only this Tailscale login gets
# through, see deploy/README.md. Never bind it to 0.0.0.0 or the Tailscale address,
# where anyone could send the login header.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5062
Environment=Access__AllowedLogins=LaugeM@github
Environment=MarkdownLog__Enabled=true
Environment=MarkdownLog__DatabasePath=/home/lauge/apps/nettomarkdowns/data/markdowns.db
Environment=Salling__ProductDatabasePath=/home/lauge/apps/nettomarkdowns/data/products.db
# Danish prices and local closing times, same as on the desktop.
Environment=TZ=Europe/Copenhagen
Environment=LANG=da_DK.UTF-8
# Workstation GC uses far less memory than the server GC that web apps default to.
Environment=DOTNET_gcServer=0
Restart=on-failure
RestartSec=30
MemoryMax=400M
UMask=0077

[Install]
WantedBy=multi-user.target
